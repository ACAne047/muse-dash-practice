<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MuseDashPracticePrototype</AssemblyName>
    <Version>0.3.13</Version>
    <GameRoot Condition="'$(GameRoot)' == ''">$(MUSEDASH_GAME_ROOT)</GameRoot>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <Target Name="ValidateGameRoot" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameRoot)\MuseDash.exe')" Text="Set GameRoot to the Muse Dash installation folder (-p:GameRoot=...)." />
    <Error Condition="!Exists('$(GameRoot)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll')" Text="MelonLoader IL2CPP assemblies are missing. Start the game with MelonLoader once to generate them." />
  </Target>
  <ItemGroup>
    <Reference Include="$(GameRoot)\MelonLoader\Il2CppAssemblies\*.dll"><Private>false</Private></Reference>
    <Reference Include="MelonLoader"><HintPath>$(GameRoot)\MelonLoader\net6\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameRoot)\MelonLoader\net6\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(GameRoot)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(GameRoot)\MelonLoader\net6\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
